[Unit]
Description=Print Quota Management System Middleware Service
After=syslog.target network.target postgresql.service

[Service]
User=printquota
Type=simple
WorkingDirectory=/opt/print-quota
ExecStart=/usr/bin/java -jar /opt/print-quota/print-quota-service.jar
Restart=always
RestartSec=10
SuccessExitStatus=143
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=print-quota-service

# Security hardening capabilities to allow binding port 443 as a non-root user
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
